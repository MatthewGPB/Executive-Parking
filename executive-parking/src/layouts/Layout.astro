---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CareersModal from '../components/CareersModal.astro';
import { media } from '../data/images.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'PAM Executive Parking | Luxury Private Valet Palm Beach',
  description = "PAM Executive Parking delivers white-glove luxury private valet service for Palm Beach's most distinguished estates, iconic private clubs, and ultra-high-net-worth families across South Florida. Absolute discretion, flawless precision, zero wait. You have arrived where you belong.",
  ogImage = media.social,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// og:image must be an absolute URL for social platforms to resolve it.
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9S3QH05DZP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9S3QH05DZP');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Executive Parking" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0a0a0f" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <CareersModal />

    <!-- Global scroll-reveal -->
    <script is:inline>
      (function () {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach((e) => e.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.18, rootMargin: '0px 0px -60px 0px' }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
    <!-- Shared, robust Formspree submit handler for every form.js-formspree.
         Hard 20s timeout + guaranteed reset means it can never hang on "Sending…". -->
    <script is:inline>
      (function () {
        function wire(form) {
          var btn = form.querySelector('[type="submit"]');
          var defaultLabel = btn ? btn.textContent : '';
          var successEl = form.getAttribute('data-success')
            ? document.getElementById(form.getAttribute('data-success'))
            : null;

          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (form.dataset.submitting === '1') return;

            // Not connected yet? Tell the developer plainly instead of hanging.
            if (form.action.indexOf('YOUR_') !== -1) {
              alert('This form isn\u2019t connected yet. Add the Formspree id in src/data/site.js.');
              return;
            }

            form.dataset.submitting = '1';
            if (btn) { btn.disabled = true; btn.textContent = 'Sending\u2026'; }

            var controller = new AbortController();
            var killer = setTimeout(function () { controller.abort(); }, 20000);

            fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
              signal: controller.signal,
            })
              .then(function (res) {
                return res.json().catch(function () { return {}; }).then(function (data) {
                  return { ok: res.ok, data: data };
                });
              })
              .then(function (r) {
                if (r.ok) {
                  form.reset();
                  if (successEl) {
                    form.hidden = true;
                    successEl.hidden = false;
                    successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  } else {
                    alert('Thank you \u2014 your message has been received.');
                  }
                } else {
                  var msg =
                    (r.data && r.data.errors && r.data.errors.map(function (x) { return x.message; }).join(', ')) ||
                    'Something went wrong. Please try again, or call (561) 377-7704.';
                  alert(msg);
                }
              })
              .catch(function () {
                alert('Your message couldn\u2019t be sent just now. Please try again, or call (561) 377-7704.');
              })
              .then(function () {
                // Always runs — success OR failure — so the button never sticks.
                clearTimeout(killer);
                form.dataset.submitting = '0';
                if (btn) { btn.disabled = false; btn.textContent = defaultLabel; }
              });
          });
        }

        document.querySelectorAll('form.js-formspree').forEach(wire);
      })();
    </script>
  </body>
</html>
