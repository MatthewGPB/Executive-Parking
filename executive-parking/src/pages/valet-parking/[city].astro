---
// ============================================================
//  Dynamic location page — one URL per entry in locations.js:
//  /valet-parking/palm-beach/, /valet-parking/miami/, etc.
//  Add a city to src/data/locations.js and it appears here
//  automatically on the next deploy.
// ============================================================
import Layout from '../../layouts/Layout.astro';
import JourneyCTA from '../../components/JourneyCTA.astro';
import { locations } from '../../data/locations.js';
import { site } from '../../data/site.js';

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { city: loc.slug },
    props: { loc },
  }));
}

const { loc } = Astro.props;

// Other cities, for the cross-linking block at the bottom.
const otherLocations = locations.filter((l) => l.slug !== loc.slug);

// ---------- Structured data ----------
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Valet Parking',
  name: `Valet Parking in ${loc.city}`,
  description: loc.metaDescription,
  areaServed: {
    '@type': 'City',
    name: loc.city,
    address: {
      '@type': 'PostalAddress',
      addressLocality: loc.city,
      addressRegion: 'FL',
      addressCountry: 'US',
    },
  },
  provider: {
    '@type': 'LocalBusiness',
    name: site.name,
    telephone: site.phone,
    email: site.email,
    url: 'https://executiveparkingpb.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: 'West Palm Beach',
      addressRegion: 'FL',
      postalCode: '33401',
      addressCountry: 'US',
    },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: loc.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={loc.metaTitle} description={loc.metaDescription}>
  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Page header -->
  <section class="page-head">
    <div class="wrap">
      <p class="loc-eyebrow reveal">{loc.county} • South Florida</p>
      <h1 class="section-title reveal" style="text-align:center">{loc.h1}</h1>
      <p class="page-head-lede reveal">{loc.lede}</p>
    </div>
  </section>

  <hr class="hairline" />

  <!-- Body copy -->
  <section class="band">
    <div class="wrap" style="max-width: 860px;">
      <div class="loc-body reveal">
        {loc.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="band band-alt">
    <div class="wrap" style="max-width: 860px;">
      <h2 class="section-title reveal" style="font-size: clamp(1.7rem,3.6vw,2.5rem); text-align:center; margin-bottom: clamp(24px,4vw,38px);">
        {loc.highlightsTitle}
      </h2>
      <ul class="loc-highlights reveal">
        {loc.highlights.map((h) => <li>{h}</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQs -->
  <section class="band">
    <div class="wrap" style="max-width: 860px;">
      <h2 class="section-title reveal" style="font-size: clamp(1.7rem,3.6vw,2.5rem); text-align:center; margin-bottom: clamp(24px,4vw,38px);">
        Frequently Asked Questions
      </h2>
      <div class="svc-list reveal">
        {loc.faqs.map((f) => (
          <details class="svc-item">
            <summary>
              <span>{f.q}</span>
              <span class="svc-mark" aria-hidden="true"></span>
            </summary>
            <div class="svc-answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-links to other service areas -->
  <section class="band band-alt">
    <div class="wrap" style="max-width: 960px;">
      <h2 class="loc-other-title reveal">Also Serving</h2>
      <nav class="loc-other reveal" aria-label="Other service areas">
        {otherLocations.map((l) => (
          <a href={`/valet-parking/${l.slug}/`}>{l.city}</a>
        ))}
      </nav>
    </div>
  </section>

  <JourneyCTA />
</Layout>

<style>
  .page-head {
    padding: clamp(120px, 16vw, 180px) 0 clamp(40px, 6vw, 60px);
    background: var(--night);
  }
  .loc-eyebrow {
    text-align: center;
    color: var(--gold-soft);
    font-size: 0.82rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .page-head-lede {
    text-align: center;
    font-style: italic;
    color: var(--text);
    font-size: clamp(1.02rem, 2.2vw, 1.32rem);
    max-width: 680px;
    margin: 22px auto 0;
  }
  .loc-body p {
    color: var(--text);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.85;
    margin: 0 0 1.4em;
  }
  .loc-body p:last-child { margin-bottom: 0; }

  .loc-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .loc-highlights li {
    color: var(--text);
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.6;
    padding: 14px 0 14px 34px;
    position: relative;
    border-bottom: 1px solid rgba(212, 175, 55, 0.12);
  }
  .loc-highlights li:last-child { border-bottom: 0; }
  .loc-highlights li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 24px;
    width: 14px;
    height: 1px;
    background: var(--gold);
  }

  .loc-other-title {
    text-align: center;
    font-family: var(--font-display, 'Playfair Display', serif);
    color: var(--text);
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    margin: 0 0 26px;
  }
  .loc-other {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 10px;
  }
  .loc-other a {
    color: var(--gold-soft);
    border: 1px solid rgba(212, 175, 55, 0.28);
    padding: 9px 18px;
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease), background 0.4s var(--ease);
  }
  .loc-other a:hover {
    color: var(--night);
    background: var(--gold);
    border-color: var(--gold);
  }
</style>
