---
import { media } from '../data/images.js';

const slides = media.slides || [];
---

{slides.length > 0 && (
  <section class="showcase" id="showcase">
    <div class="showcase-shell reveal">
      <button class="sc-arrow sc-prev" id="scPrev" aria-label="Previous image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="#d4af37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="sc-track" id="scTrack" role="list">
        {slides.map((src, i) => (
          <div class="sc-slide" role="listitem">
            <img
              src={src}
              alt={`Executive Parking — gallery image ${i + 1}`}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        ))}
      </div>

      <button class="sc-arrow sc-next" id="scNext" aria-label="Next image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="#d4af37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="sc-dots" id="scDots">
      {slides.map((_, i) => (
        <button class={`sc-dot${i === 0 ? ' active' : ''}`} type="button" data-idx={i} aria-label={`Go to image ${i + 1}`}></button>
      ))}
    </div>
  </section>
)}

<style>
  .showcase {
    background: var(--night);
    padding: clamp(40px, 6vw, 70px) 0 clamp(50px, 7vw, 80px);
    overflow: hidden;
  }

  .showcase-shell {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(12px, 3vw, 32px);
  }

  .sc-track {
    display: flex;
    gap: clamp(16px, 3vw, 34px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex: 1;
    padding: 4px 0 8px;
  }
  .sc-track::-webkit-scrollbar { display: none; }

  .sc-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }
  .sc-slide img {
    width: 100%;
    height: clamp(240px, 46vw, 560px);
    object-fit: cover;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.72);
  }

  .sc-arrow {
    flex: 0 0 auto;
    width: 52px; height: 52px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 50%;
    background: rgba(7, 7, 9, 0.6);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease), opacity 0.3s;
  }
  .sc-arrow:hover { background: rgba(212, 175, 55, 0.14); border-color: var(--gold); }
  .sc-arrow:disabled { opacity: 0.28; cursor: default; }

  .sc-dots {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 26px;
  }
  .sc-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .sc-dot.active { background: var(--gold); transform: scale(1.3); }

  @media (max-width: 880px) {
    .sc-arrow { display: none; }
    .showcase-shell { padding: 0 16px; }
  }
</style>

<script is:inline>
  (function () {
    var track = document.getElementById('scTrack');
    if (!track) return;

    var prev = document.getElementById('scPrev');
    var next = document.getElementById('scNext');
    var dotsWrap = document.getElementById('scDots');
    var slides = Array.prototype.slice.call(track.querySelectorAll('.sc-slide'));
    var dots = dotsWrap ? Array.prototype.slice.call(dotsWrap.querySelectorAll('.sc-dot')) : [];
    var current = 0;
    var autoTimer = null;

    function goTo(i, smooth) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      current = i;
      track.scrollTo({ left: slides[i].offsetLeft, behavior: smooth === false ? 'auto' : 'smooth' });
      sync();
    }

    function sync() {
      dots.forEach(function (d, di) { d.classList.toggle('active', di === current); });
      if (prev) prev.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
    }

    function stopAuto() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }

    // Gentle autoplay; stops for good once the visitor takes control.
    function startAuto() {
      stopAuto();
      autoTimer = setInterval(function () {
        goTo(current >= slides.length - 1 ? 0 : current + 1);
      }, 6000);
    }

    var raf;
    track.addEventListener('scroll', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        var center = track.scrollLeft + track.clientWidth / 2;
        var best = 0, bestDist = Infinity;
        slides.forEach(function (s, si) {
          var sc = s.offsetLeft + s.clientWidth / 2;
          var d = Math.abs(sc - center);
          if (d < bestDist) { bestDist = d; best = si; }
        });
        if (best !== current) { current = best; sync(); }
      });
    }, { passive: true });

    if (prev) prev.addEventListener('click', function () { stopAuto(); goTo(current - 1); });
    if (next) next.addEventListener('click', function () { stopAuto(); goTo(current + 1); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { stopAuto(); goTo(parseInt(d.dataset.idx, 10)); });
    });
    track.addEventListener('pointerdown', stopAuto, { passive: true });

    sync();

    // Only autoplay once the section is actually on screen.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { startAuto(); } else { stopAuto(); }
        });
      }, { threshold: 0.35 });
      io.observe(document.getElementById('showcase'));
    }
  })();
</script>
